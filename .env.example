CARIKOSTKITA_API_URL=https://carikostkitafastapi.vercel.app
NEXT_PUBLIC_API_URL=https://carikostkitafastapi.vercel.app

# Server-only token for Vercel Blob. On Vercel this is injected when the
# project is linked to a Blob store; for local development run
# `vercel env pull` or copy the value from the Vercel dashboard.
# NEVER expose this token in a NEXT_PUBLIC_* variable or commit it.
# BLOB_READ_WRITE_TOKEN=

# Optional: enables Realtime broadcast after confirmed saves (primary sync
# path for open Landing Pages). Public anon key only - NEVER service-role.
# When these are absent the dashboard fetches the browser-safe `anon`
# credentials from /api/public/realtime-config at runtime.
# NEXT_PUBLIC_SUPABASE_URL=https://gtnsmljlztypqefhojjn.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
